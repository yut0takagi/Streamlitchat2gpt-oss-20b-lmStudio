# ==========================================================
# Example environment variables for opencode with LM Studio
# ==========================================================

# API Key (LM Studio は実際には不要。ダミー値でOK)
OPENAI_API_KEY=lmstudio
OPENAI_MODEL=openai/gpt-oss-20b

# LM Studio の OpenAI互換 API エンドポイント
# 既定ポートは 1234。必要に応じて変更してください。
OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# SerpAPI
SERPAPI_KEY=***

# Optional: 本家 OpenAI API を使いたい場合に切替用
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1